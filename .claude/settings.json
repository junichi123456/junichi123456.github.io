{
  "permissions": {
    "allow": [
      "Read(pokechamp/logs/**)",
      "Bash(python battle.py *)",
      "Bash(python learn.py *)",
      "Bash(python pokechamp/tool/battle.py *)",
      "Bash(python pokechamp/tool/learn.py *)",
      "Bash(python3 battle.py *)",
      "Bash(python3 learn.py *)",
      "Bash(python3 pokechamp/tool/battle.py *)",
      "Bash(python3 pokechamp/tool/learn.py *)",
      "Bash(python wait_event.py *)",
      "Bash(python pokechamp/tool/wait_event.py *)",
      "Bash(python wait_event.py)",
      "Bash(python pokechamp/tool/wait_event.py)",
      "Read(pokechamp/logs/live/**)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "-c",
              "import os,runpy\nd=os.environ.get('CLAUDE_PROJECT_DIR') or os.getcwd()\nfor _ in range(4):\n    p=os.path.join(d,'pokechamp','tool','hook_latest.py')\n    if os.path.exists(p):\n        runpy.run_path(p,run_name='__main__')\n        break\n    d=os.path.dirname(d)\n"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
